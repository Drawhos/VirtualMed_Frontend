# .env-ejemplo

# API Backend (.NET)
NEXT_PUBLIC_API_URL=http://localhost:5045/api
NEXT_PUBLIC_WS_URL=ws://localhost:5045/hubs/video-chat

# Chatbot RAG (FastAPI) — el frontend se conecta directo a POST /chat
NEXT_PUBLIC_AI_URL=http://localhost:8000

# WebRTC
NEXT_PUBLIC_TURN_SERVER_URL=turn:localhost:3478
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_PASSWORD=

# OAuth (Wearables)
NEXT_PUBLIC_FITBIT_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_FIT_CLIENT_ID=
